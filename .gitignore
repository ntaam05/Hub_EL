# Root Git Ignore for Hub-EL Monorepo

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# Next.js Build & Outputs
**/.next/
**/out/

# Production builds & Compilations
**/build/
**/dist/
*.tsbuildinfo
next-env.d.ts

# Flutter & Dart Ephemeral
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/doc/api/
**/*.symbols
**/*.map.json

# Android Studio & Gradle
**/.gradle/
**/local.properties
**/android/.gradle/
**/android/.kotlin/
**/android/app/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/*.apk
**/*.aab

# iOS
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/.symlinks/

# Environment files & Secrets (Safety first: keep secrets local)
**/.env
**/.env.local
**/.env*.local
**/.env.development
**/.env.test
**/.env.production
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Temp
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
